<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>dd1e0a1e-efb8-4f1f-9274-a1e4398cca4a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Experiments/**/*.cs" />
    <None Include="../../data/*.csv" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
  </ItemGroup>

</Project>
